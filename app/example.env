# ==========================================
# MAS PLATFORM - 100% FREE-TIER ENVIRONMENT
# ==========================================

# 1. FREE CLOUD LLM PROVIDERS (No local GPU needed)
# Groq: Free API Key from https://console.groq.com (Runs LLaMA 3.3 70B & 3.1 8B on LPUs)
GROQ_API_KEY=

# Google Gemini: Free API Key from https://aistudio.google.com (Runs Gemini 1.5/2.0 Flash)
GEMINI_API_KEY=

# 2. LOCAL LLM (Optional - only if running Ollama locally)
OLLAMA_BASE_URL=http://localhost:11434

# 3. DATABASE CONFIGURATION
# Local Docker Postgres with pgvector (default port 54320)
DATABASE_URL=postgresql+psycopg://myuser:mypassword@localhost:54320/mydatabase
POSTGRES_URI=postgresql://myuser:mypassword@localhost:54320/mydatabase

# Or Cloud Free PostgreSQL (e.g., Neon.tech serverless postgres):
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xyz.neon.tech/neondb?sslmode=require
# POSTGRES_URI=postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require

# 4. EMBEDDINGS PROVIDER
# Options: 'gemini' (Free cloud, 0 local GPU/CPU) or 'huggingface' (Local CPU)
EMBEDDING_PROVIDER=gemini

# 5. WEB SEARCH TOOL
# If blank, system automatically falls back to DuckDuckGo (100% Free, no key needed)
TAVILY_API_KEY=

# 6. LOCAL FILE STORAGE FOR KNOWLEDGE BASES
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploaded_data
